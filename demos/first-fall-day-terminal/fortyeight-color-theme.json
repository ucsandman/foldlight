  "tokenColors": [
    {
      "name": "Comment, the shade the light does not reach",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#938568", "fontStyle": "italic" }
    },
    {
      "name": "Keyword and storage, the cold sky above the roof line",
      "scope": ["keyword", "storage", "storage.type", "keyword.control", "variable.language", "entity.name.tag"],
      "settings": { "foreground": "#7ba2c1" }
    },
    {
      "name": "String and property, the steel clip on the cover",
      "scope": ["string", "string.quoted", "support.type.property-name", "entity.other.attribute-name", "variable.other.property"],
      "settings": { "foreground": "#acb2b9" }
    },
    {
      "name": "Number and constant, the grey board of the cover",
      "scope": ["constant", "constant.numeric", "constant.language", "support.constant", "constant.other.color"],
      "settings": { "foreground": "#a19c87" }
    },
    {
      "name": "Function and class, the face of the light",
      "scope": ["entity.name.function", "entity.name.class", "entity.name.type", "support.function", "meta.function-call"],
      "settings": { "foreground": "#cbb588" }
    },
    {
      "name": "Variable and plain text",
      "scope": ["variable", "variable.other", "meta.definition.variable", "source"],
      "settings": { "foreground": "#cbb588" }
    },
    {
      "name": "Operator and punctuation, one step back",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#938568" }
    },
    {
      "name": "Invalid, the one warm slot",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ba8464" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#937b47" }
    }
  ]
}
